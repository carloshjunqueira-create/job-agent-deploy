{
  "schema_version": "1.0.0",
  "note": "Cada fonte pode ser ligada ou desligada. Fontes com requires_secret so rodam se o Secret existir no repositorio; se faltar, a fonte e pulada e o relatorio da rodada avisa.",
  "sources": [
    {
      "id": "adzuna_br",
      "label": "Adzuna Brasil",
      "module": "adzuna.mjs",
      "enabled": true,
      "requires_secret": ["ADZUNA_APP_ID", "ADZUNA_APP_KEY"],
      "options": { "country": "br", "results_per_page": 50, "max_pages": 2, "max_days_old": 45 },
      "scope": ["city"]
    },
    {
      "id": "adzuna_intl",
      "label": "Adzuna internacional (US/GB/CA)",
      "module": "adzuna.mjs",
      "enabled": true,
      "requires_secret": ["ADZUNA_APP_ID", "ADZUNA_APP_KEY"],
      "options": { "country": ["us", "gb", "ca"], "results_per_page": 50, "max_pages": 1, "max_days_old": 30, "remote_only": true },
      "scope": ["remote_international"]
    },
    {
      "id": "jooble_br",
      "label": "Jooble Brasil",
      "module": "jooble.mjs",
      "enabled": true,
      "requires_secret": ["JOOBLE_API_KEY"],
      "options": { "host": "br.jooble.org", "pages": 2 },
      "scope": ["city"]
    },
    {
      "id": "remotive",
      "label": "Remotive (remoto internacional)",
      "module": "remotive.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": { "limit": 200 },
      "scope": ["remote_international"]
    },
    {
      "id": "remoteok",
      "label": "RemoteOK (remoto internacional)",
      "module": "remoteok.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": {},
      "scope": ["remote_international"]
    },
    {
      "id": "arbeitnow",
      "label": "Arbeitnow (remoto Europa)",
      "module": "arbeitnow.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": { "max_pages": 3 },
      "scope": ["remote_international"]
    },
    {
      "id": "himalayas",
      "label": "Himalayas (remoto internacional)",
      "module": "himalayas.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": { "limit": 100 },
      "scope": ["remote_international"]
    },
    {
      "id": "gupy",
      "label": "Gupy (portal publico, best-effort)",
      "module": "gupy.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": { "limit": 60 },
      "scope": ["city"],
      "note": "Endpoint publico nao documentado. Se a Gupy mudar a API, a fonte falha sozinha e o resto da rodada continua."
    },
    {
      "id": "ats_boards",
      "label": "Paginas de carreira (Greenhouse / Lever / Ashby)",
      "module": "ats.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": { "greenhouse": [], "lever": [], "ashby": [] },
      "scope": ["city", "remote_international"],
      "note": "Adicione o slug das empresas-alvo. Ex.: greenhouse: [\"nubank\"], lever: [\"loft\"]. Cobre vagas que nao aparecem em agregadores."
    },
    {
      "id": "rss",
      "label": "Feeds RSS personalizados",
      "module": "rss.mjs",
      "enabled": true,
      "requires_secret": [],
      "options": { "feeds": [] },
      "scope": ["city", "remote_international"],
      "note": "Cole URLs de RSS (alertas de emprego, boards de nicho). Ex.: https://weworkremotely.com/categories/remote-management-and-finance-jobs.rss"
    }
  ]
}
